      "post_date": "Tue Sep 26, 2006 12:07 pm",
      "post_datetime": "2006-09-26T17:07:00+00:00",
      "post_subject": "Power/wavelength conversions",
      "content_md": "The power versus wavelength characteristic is different for every sensor. You would need to get the chart from the sensor or meter manufacturer, unless the meter compensates automatically.",
      "signature": "",
      "attachments": [],
      "quotes": [],
      "is_first_post": false,
