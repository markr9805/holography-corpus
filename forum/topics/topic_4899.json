    {
      "post_id": 40028,
      "topic_id": 4899,
      "topic_title": "Mother's Day Project",
      "forum_id": 32,
      "forum_name": "Gallery",
      "author": "Junior",
      "author_id": null,
      "post_date": "Thu Jun 16, 2005 5:38 am",
      "post_datetime": "2005-06-16T10:38:00+00:00",
      "post_subject": "Mother's Day Project",
      "content_md": "I use a CNI MSL-20 DPSS rated at 30mW for two beam setups.\n\nH1:\n\n-VRP-M 5x4\"\n\n-exposure 10 sec\n\n-development with Dokumol (commercial developer, Tetenal)\n\n-fixing with Superfix (commercial fxer, Tetenal)\n\n-bleach K3[Fe(CN)6]/KBr\n\nH2:\n\n-Ultimate15 5x4\"\n\n-exposure 20 sec\n\n-development with Gentet's standard chemistry\n\nJunior",
      "signature": "",
      "attachments": [],
      "quotes": [],
      "is_first_post": false,
      "url": "https://holographyforum.org/forum/viewtopic.php?p=40028#p40028"
    },
