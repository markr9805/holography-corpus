    {
      "post_id": 25913,
      "topic_id": 3213,
      "topic_title": "My Entry to PCG",
      "forum_id": 32,
      "forum_name": "Gallery",
      "author": "Tony",
      "author_id": null,
      "post_date": "Sun Mar 13, 2005 12:05 pm",
      "post_datetime": "2005-03-13T17:05:00+00:00",
      "post_subject": "My Entry to PCG",
      "content_md": "The original reference angle was less than Brewster. I started at Brewster and then cheated in a bit to get the object more centered in the plate, so I'd guess it was around 45 degrees. Woodgrain was not a problem. \n\nThe illumination angle on replay was not measured, but it was certainly greater than the 45 degrees used for exposure. \n\nThe BB-640 when processed for no shrinkage will replay anywhere from the original deep red at the nominal angle to a yellow-green at very high illumination angles (near tangent to the plate).",
      "signature": "",
      "attachments": [],
      "quotes": [],
      "is_first_post": false,
      "url": "https://holographyforum.org/forum/viewtopic.php?p=25913#p25913"
